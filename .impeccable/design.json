  "narrative": {
    "northStar": "The compact voice utility",
    "overview": "Forest-charcoal surfaces and mint actions make a quiet working canvas for local dictation and daily planning. Fine borders, readable lettering, and restrained amber reminders keep operational state easy to find. Controls are crisp and compact; content supplies the hierarchy without decorative imagery.\n\nThe approved replacement world is implemented in Tauri 2, React 19, and TypeScript. This document records `desktop/src/tokens.css`, `styles.css`, and the implemented components and pages. It supersedes the earlier light Qt design document. The selected composition remains in `.impeccable/surface-brief.md` and the approved mockups; implementation values govern this system. Five palettes now offer authored light and dark variants, System brightness, instant two-window synchronization, and persistent island visibility controls.",
    "keyCharacteristics": [
      "Forest surfaces separated by fine borders and small tonal changes.",
      "Mint primary actions, progress, and keyboard focus; amber reminder emphasis.",
      "Locally bundled Encode Sans, sentence-case labels, and tabular countdowns.",
      "Seven visible tools in a labeled rail and a separate contextual island.",
      "Semantic controls, code-drawn SVG icons, and live waveform bars."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Keep recording, processing, error, and reminder meaning in visible text or accessible names alongside color and icons.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use bundled Encode Sans for titles, controls, and numerals; apply tabular figures to durations and counts instead of changing font.",
        "section": "typography"
      },
      {
        "name": "The Bordered Surface Rule",
        "body": "Separate resting groups with tonal fills and fine strokes; use the recorded shadows for transient layers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use forest tonal layers and fine borders to group content.",
      "Do keep mint actions and focus distinct from amber reminder emphasis.",
      "Do use bundled Encode Sans and tabular figures for countdowns.",
      "Do pair operational color and icons with written state or accessible names.",
      "Do preserve the island's visible native footprint and scroll its expanded body.",
      "Do keep reminders quiet while dictation is active and expose pending items afterward."
    ],
    "donts": [
      "Don't inherit legacy Qt styling or replace the bundled typography when changing brightness.",
      "Don't replace semantic controls, text, icons, or waveforms with raster screenshots.",
      "Don't add decorative eyebrows above working headings or idle focus content.",
      "Don't use ambient shadows on every resting panel.",
      "Don't treat preview screenshots as proof of physical microphone, DPI, or screen-reader behavior."
    ]
  }
}
